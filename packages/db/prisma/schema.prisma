generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  owner
  editor
  viewer
}

enum FileKind {
  code
  doc
  board
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  isGuest      Boolean  @default(false) @map("is_guest")
  createdAt    DateTime @default(now()) @map("created_at")

  refreshTokens RefreshToken[]
  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]
  messages      Message[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Project {
  id         String      @id @default(uuid())
  name       String
  ownerId    String      @map("owner_id")
  inviteCode String      @unique @map("invite_code")
  inviteRole ProjectRole @default(editor) @map("invite_role")
  createdAt  DateTime    @default(now()) @map("created_at")

  // Set when the project is linked to a GitHub repository (import or first push).
  githubOwner  String? @map("github_owner")
  githubRepo   String? @map("github_repo")
  githubBranch String? @map("github_branch")

  owner    User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members  ProjectMember[]
  files    File[]
  messages Message[]

  @@map("projects")
}

model ProjectMember {
  projectId String      @map("project_id")
  userId    String      @map("user_id")
  role      ProjectRole @default(editor)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

model File {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  path        String
  // The GitHub branch this file belongs to ("" for projects without a repository). Only the
  // project's active branch is shown, so every branch keeps its own files and edits.
  branch      String    @default("")
  type        FileKind  @default(code)
  language    String?
  yjsState    Bytes?    @map("yjs_state")
  // Git blob SHA of the content as of the last sync with GitHub; lets a push see what changed.
  sourceSha   String?   @map("source_sha")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  // A deleted file stays in the project's trash: its path moves under ".trash/<id>/" and the original is kept here.
  deletedAt   DateTime? @map("deleted_at")
  trashedPath String?   @map("trashed_path")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, branch, path])
  @@map("files")
}

model Message {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([projectId, createdAt])
  @@map("messages")
}
