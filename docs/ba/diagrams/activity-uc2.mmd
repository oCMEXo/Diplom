flowchart TB
  s((●)) --> a1[Editor presses Run]
  a1 --> d0{Public host with<br>access code?}
  d0 -- yes, code not entered --> a0[Ask for the access code] --> d0b{Code correct?}
  d0b -- no --> a0
  d0b -- yes --> a2
  d0 -- no --> a2[Take the current text and<br>the other project files]
  a2 --> a3[Queue the run]
  a3 --> a4[Execute in an isolated container:<br>no network, 128 MB, 0.5 CPU]
  a4 --> d1{Finished within 10 s?}
  d1 -- no --> a5[Stop the container,<br>status = timeout]
  d1 -- yes --> d2{Exit code 0?}
  d2 -- yes --> a6[Status = finished]
  d2 -- no --> a7[Status = error,<br>highlight the error line]
  a5 --> a8[Stream output, status and<br>duration to all participants]
  a6 --> a8
  a7 --> a8
  a8 --> e((◉))
