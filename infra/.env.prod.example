# Hostnames that point at the EC2 instance. Without a domain, sslip.io works:
#   API_DOMAIN=api.203-0-113-10.sslip.io   COLLAB_DOMAIN=collab.203-0-113-10.sslip.io
API_DOMAIN=api.example.com
COLLAB_DOMAIN=collab.example.com

# RDS PostgreSQL. Append ?sslmode=require&schema=public
DATABASE_URL=postgresql://collab:CHANGE_ME@your-db.xxxxxxxx.eu-central-1.rds.amazonaws.com:5432/collab?schema=public&sslmode=require

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING

# Origin(s) the web app is served from (the CloudFront domain), comma-separated.
CORS_ORIGIN=https://dxxxxxxxxxxxxx.cloudfront.net
